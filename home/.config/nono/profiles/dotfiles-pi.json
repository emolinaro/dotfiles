{
  "extends": "dotfiles-agent-base",
  "meta": {
    "name": "dotfiles-pi",
    "version": "1.0.0",
    "description": "Pi with repository-scoped access",
    "author": "dotfiles"
  },
  "filesystem": {
    "allow": [
      "$HOME/.pi"
    ],
    "deny": [
      "$HOME/.pi/agent/AGENTS.md",
      "$HOME/.pi/agent/extensions"
    ]
  }
}
