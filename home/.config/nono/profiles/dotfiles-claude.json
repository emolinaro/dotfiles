{
  "extends": "dotfiles-agent-base",
  "meta": {
    "name": "dotfiles-claude",
    "version": "1.0.0",
    "description": "Claude Code with repository-scoped access",
    "author": "dotfiles"
  },
  "groups": {
    "include": [
      {
        "name": "claude_cache_linux",
        "when": "linux"
      }
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$HOME/.cache/claude",
      "$HOME/.local/state/claude/locks"
    ],
    "read": [
      "$HOME/.local/share/claude"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock"
    ],
    "deny": [
      "$HOME/.claude/hooks",
      "$HOME/.claude/plugins",
      "$HOME/.claude/settings.json"
    ]
  }
}
