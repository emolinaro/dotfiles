{
  "extends": "dotfiles-agent-base",
  "meta": {
    "name": "dotfiles-codex",
    "version": "1.0.0",
    "description": "Codex with repository-scoped access",
    "author": "dotfiles"
  },
  "filesystem": {
    "allow": [
      "$HOME/.codex"
    ],
    "deny": [
      "$HOME/.codex/AGENTS.md",
      "$HOME/.codex/config.toml",
      "$HOME/.codex/skills"
    ]
  }
}
