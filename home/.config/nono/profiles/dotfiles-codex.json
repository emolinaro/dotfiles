{
  "extends": "dotfiles-agent-base",
  "meta": {
    "name": "dotfiles-codex",
    "version": "1.0.0",
    "description": "Codex with repository-scoped access",
    "author": "dotfiles"
  },
  "groups": {
    "include": [
      {
        "name": "codex_macos",
        "when": "macos"
      }
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.codex"
    ]
  }
}
