{
  "extends": "default",
  "meta": {
    "name": "dotfiles-agent-base",
    "version": "1.0.0",
    "description": "Shared sandbox boundary for terminal coding agents",
    "author": "dotfiles"
  },
  "groups": {
    "include": [
      "node_runtime",
      "python_runtime",
      "rust_runtime",
      "nix_runtime",
      "git_config",
      "unlink_protection",
      {
        "name": "linux_sysfs_read",
        "when": "linux"
      }
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$HOME/.gstack",
      "$TMPDIR"
    ],
    "read": [
      "@git:config-files",
      "@git:hooks-path",
      "$HOME/.agents",
      "$HOME/.local/share/gstack/repos/gstack",
      "$HOME/.config/herdr",
      "$HOME/.dotfiles/home/.config/herdr"
    ],
    "read_file": [
      "$HOME/.dotfiles/home/AGENTS.md",
      "$HOME/.dotfiles/home/.claude/settings.json"
    ],
    "deny": [
      "/tmp",
      "/private/tmp",
      "/private/var/folders",
      "/var/folders",
      "$SSH_AUTH_SOCK",
      "/var/run/docker.sock",
      "/run/docker.sock",
      "$HOME/.docker/run/docker.sock",
      "$HOME/.orbstack/run/docker.sock"
    ]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "network": {
    "block": false
  },
  "workdir": {
    "access": "none"
  },
  "environment": {
    "allow_vars": [
      "CDPATH",
      "COLORTERM",
      "EDITOR",
      "FORCE_COLOR",
      "HOME",
      "IN_NIX_SHELL",
      "LANG",
      "LANGUAGE",
      "LC_*",
      "LESS",
      "LOGNAME",
      "LS_COLORS",
      "MANPATH",
      "NIX_PATH",
      "NIX_PROFILES",
      "NIX_SSL_CERT_FILE",
      "NO_COLOR",
      "NO_MISTAKES_NO_UPDATE_CHECK",
      "PAGER",
      "PATH",
      "PWD",
      "SHELL",
      "SHLVL",
      "SSL_CERT_DIR",
      "SSL_CERT_FILE",
      "TEMP",
      "TERM",
      "TERMINFO",
      "TERMINFO_DIRS",
      "TERM_PROGRAM",
      "TERM_PROGRAM_VERSION",
      "TMP",
      "TMPDIR",
      "TZ",
      "USER",
      "VISUAL",
      "XDG_CACHE_HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_RUNTIME_DIR",
      "XDG_STATE_HOME"
    ],
    "deny_vars": [
      "ANTHROPIC_*",
      "OPENAI_*",
      "GEMINI_*",
      "AWS_*",
      "AZURE_*",
      "GOOGLE_*",
      "GCP_*",
      "GH_*",
      "GITHUB_*",
      "GITLAB_*",
      "BITBUCKET_*",
      "KUBECONFIG",
      "KUBE_*",
      "DOCKER_*",
      "CONTAINER_*",
      "PODMAN_*",
      "SSH_*",
      "NPM_TOKEN",
      "NPM_CONFIG_*",
      "TF_VAR_*",
      "VAULT_*"
    ],
    "set_vars": {
      "XDG_CONFIG_HOME": "$HOME/.config"
    }
  },
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target"
    ],
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9]*"
    ]
  },
  "interactive": true
}
